---
import { type CollectionEntry, getCollection, render } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import BackButton from "@/pages/posts/[...slug]/_components/BackButton.astro";
import Tag from "@/components/Tag.astro";
import { getEventSlug } from "@/utils/getEventPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => !data.draft);
  return events.map(event => ({
    params: { slug: getEventSlug(event.id, event.filePath) },
    props: { event },
  }));
}

type Props = {
  event: CollectionEntry<"events">;
};

const { event } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const { title, date, description, location, time, presenters, tags, mode } =
  event.data;

const { Content } = await render(event);

const datetime = date
  ? dayjs(date).tz(event.data.timezone ?? config.site.timezone)
  : null;

const modeLabel = mode ? t.event.mode[mode] : null;
---

<Layout title={`${title} | ${config.site.title}`} description={description ?? title}>
  <Header />

  <Breadcrumb />

  <BackButton />

  <main id="main-content" class="app-layout mt-8" data-pagefind-body>
    <h1
      style={{ viewTransitionName: toTransitionName(title) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <dl class="text-muted-foreground mt-4 grid gap-y-1 text-sm sm:text-base">
      {
        datetime && (
          <div class="flex gap-x-2">
            <dt class="font-medium">{`${t.event.dateLabel}:`}</dt>
            <dd>
              <time datetime={datetime.toISOString()}>
                {datetime.format("D MMM, YYYY")}
              </time>
            </dd>
          </div>
        )
      }
      {time && (
        <div class="flex gap-x-2">
          <dt class="font-medium">{`${t.event.timeLabel}:`}</dt>
          <dd>{time}</dd>
        </div>
      )}
      {location && (
        <div class="flex gap-x-2">
          <dt class="font-medium">{`${t.event.locationLabel}:`}</dt>
          <dd>{location}</dd>
        </div>
      )}
      {modeLabel && (
        <div class="flex gap-x-2">
          <dt class="font-medium">{`${t.event.modeLabel}:`}</dt>
          <dd>{modeLabel}</dd>
        </div>
      )}
      {
        presenters && presenters.length > 0 && (
          <div class="flex gap-x-2">
            <dt class="font-medium">{`${t.event.presentersLabel}:`}</dt>
            <dd>{presenters.join(", ")}</dd>
          </div>
        )
      }
    </dl>

    {description && (
      <p class="border-border mt-6 border-l-2 pl-4 text-base italic">
        {description}
      </p>
    )}

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    {tags && tags.length > 0 && (
      <ul class="mt-8 flex flex-wrap gap-4">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
      </ul>
    )}
  </main>

  <Footer />
</Layout>